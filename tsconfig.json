{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "node",
      "vite/client"
    ],
    "paths": {
      "qr-stream": [
        "./src/index.ts"
      ],
      "qr-stream/react": [
        "./src/react/index.ts"
      ],
      "qr-stream/browser": [
        "./src/browser.ts"
      ],
      "qr-stream/qr": [
        "./src/qr.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "demo"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
