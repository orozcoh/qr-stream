{
  "name": "qr-stream",
  "version": "0.1.0",
  "description": "Reliable one-way file transfer between devices using animated fountain-coded QR codes, with an offline PWA and a React reader/writer.",
  "keywords": [
    "qr",
    "qr-code",
    "fountain-code",
    "airgap",
    "offline",
    "file-transfer",
    "pwa",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "import": "./dist/qr.js"
    },
    "./browser/zxing": {
      "types": "./dist/browser/decoders/zxing.d.ts",
      "import": "./dist/zxing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "react": ">=19",
    "zxing-wasm": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zxing-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orozcoh/qr-stream.git"
  },
  "homepage": "https://github.com/orozcoh/qr-stream#readme",
  "bugs": {
    "url": "https://github.com/orozcoh/qr-stream/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
