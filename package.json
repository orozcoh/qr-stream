{
  "name": "@orozcoh/qr-stream",
  "version": "0.2.0",
  "description": "Reliable one-way file transfer between devices using animated fountain-coded QR codes, with an offline PWA and a React reader/writer.",
  "keywords": [
    "qr",
    "qr-code",
    "fountain-code",
    "airgap",
    "offline",
    "file-transfer",
    "pwa",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "import": "./dist/qr.js"
    },
    "./browser/zxing": {
      "types": "./dist/browser/decoders/zxing.d.ts",
      "import": "./dist/zxing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:react18": "tsc -p tests/react18/tsconfig.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "prepublishOnly": "pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "dependency-cruiser .",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile esm-only && knip",
    "check:size": "size-limit"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "react": ">=19",
    "zxing-wasm": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zxing-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react18": "npm:@types/react@^18.3.31",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "knip": "^5.88.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^12.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orozcoh/qr-stream.git"
  },
  "homepage": "https://github.com/orozcoh/qr-stream#readme",
  "bugs": {
    "url": "https://github.com/orozcoh/qr-stream/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
